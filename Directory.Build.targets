<Project>

  <!--
    privacy-no-networking-code (decision 0006): every project is compiled with the banned-API analyzer
    and privacy/BannedSymbols.txt, so using networking fails the build. Only a project that sets
    PrivacyException, and is listed in privacy/exceptions.json, is built without it. See privacy/README.md.
  -->
  <PropertyGroup Condition="'$(PrivacyException)' != 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(PrivacyException)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="$(PrivacyBanAnalyzerVersion)" PrivateAssets="all" IncludeAssets="analyzers" />
    <AdditionalFiles Include="$(PrivacyBannedSymbols)" />
  </ItemGroup>

  <!-- The privacy tests run the same analyzer on snippets of code, so they also reference it as a library. -->
  <PropertyGroup Condition="'$(PrivacyAnalyzerAsLibrary)' == 'true'">
    <_PrivacyAnalyzerDir>$(NuGetPackageRoot)microsoft.codeanalysis.bannedapianalyzers\$(PrivacyBanAnalyzerVersion)\analyzers\dotnet\cs\</_PrivacyAnalyzerDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(PrivacyAnalyzerAsLibrary)' == 'true'">
    <Reference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" HintPath="$(_PrivacyAnalyzerDir)Microsoft.CodeAnalysis.BannedApiAnalyzers.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers" HintPath="$(_PrivacyAnalyzerDir)Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers.dll" />
  </ItemGroup>

  <!--
    Avalonia's build telemetry is off (decision 0006; privacy/README.md). Avalonia brings Avalonia.BuildServices,
    whose build task sends usage data to the Avalonia team on every build. Every project references it here with
    all its assets excluded, which also covers projects that get Avalonia indirectly, so its task is never imported.
    The empty AvaloniaStats target is a second layer, should the task's target get in some other way. A test under
    privacy-dependencies fails if any project resolves the package with its build assets.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.BuildServices" Version="$(AvaloniaBuildServicesVersion)" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="AvaloniaStats" />

  <!--
    A project can keep a package file out of what it ships by declaring <PrivacyRemovedFromOutput Include="file" />,
    as the desktop application does for Avalonia's previewer support, which uses sockets. The dependency check reads
    the same declaration: it then requires the file to be absent, instead of reporting it missing. See privacy/README.md.
  -->
  <Target Name="PrivacyRemoveFromOutput" AfterTargets="ResolvePackageAssets" Condition="'@(PrivacyRemovedFromOutput)' != ''">
    <ItemGroup>
      <_PrivacyRemoved Include="@(PrivacyRemovedFromOutput)" DestinationSubPath="%(Identity)" />
      <RuntimeCopyLocalItems Remove="@(_PrivacyRemoved)" MatchOnMetadata="DestinationSubPath" />
    </ItemGroup>
  </Target>

  <!-- The ban fails closed: if anything has switched it off for this project, the build fails. -->
  <Target Name="PrivacyBanGuard" BeforeTargets="CoreCompile" Condition="'$(PrivacyException)' != 'true'">
    <PropertyGroup>
      <_PrivacyBanFile>$([MSBuild]::NormalizePath('$(PrivacyBannedSymbols)'))</_PrivacyBanFile>
      <_PrivacyRule>privacy-no-networking-code: no code that can see a statement may use the network (decision 0006, docs/decisions/0006-privacy-approach-and-network-boundary.md). See privacy/README.md.</_PrivacyRule>
    </PropertyGroup>
    <ItemGroup>
      <_PrivacyBanAnalyzer Include="@(Analyzer)" Condition="'%(Filename)%(Extension)' == 'Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers.dll'" />
      <_PrivacyBanList Include="@(AdditionalFiles)" Condition="'%(FullPath)' == '$(_PrivacyBanFile)'" />
    </ItemGroup>
    <Error Code="PRIVACY001" Condition="!Exists('$(_PrivacyBanFile)')" Text="The networking ban list $(_PrivacyBanFile) is missing. $(_PrivacyRule)" />
    <Error Code="PRIVACY001" Condition="'@(_PrivacyBanAnalyzer)' == ''" Text="The banned-API analyzer is not active in $(MSBuildProjectName). $(_PrivacyRule)" />
    <Error Code="PRIVACY001" Condition="'@(_PrivacyBanList)' == ''" Text="The networking ban list is not passed to the analyzer in $(MSBuildProjectName). $(_PrivacyRule)" />
    <Error Code="PRIVACY001" Condition="'$(RunAnalyzers)' == 'false' or '$(RunAnalyzersDuringBuild)' == 'false'" Text="Analyzers are switched off in $(MSBuildProjectName), which switches off the networking ban. $(_PrivacyRule)" />
    <Error Code="PRIVACY001" Condition="$(NoWarn.Contains('RS0030')) or $(WarningsNotAsErrors.Contains('RS0030'))" Text="The networking ban (RS0030) is silenced in $(MSBuildProjectName). $(_PrivacyRule)" />
  </Target>

</Project>
