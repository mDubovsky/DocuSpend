<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DocuSpend.Presentation"
        xmlns:cat="using:DocuSpend.Categorization.Model"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:look="using:DocuSpend.Desktop.Look"
        xmlns:lookvm="using:DocuSpend.Presentation.Look"
        x:Class="DocuSpend.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static vm:Texts.AppTitle}"
        Width="1280" Height="880" MinWidth="720" MinHeight="520"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <!-- Escape takes back a row's "Odstrániť toto pravidlo?"; it does nothing while no row asks -->
    <KeyBinding Gesture="Escape" Command="{Binding KeepRuleCommand}" />
  </Window.KeyBindings>

  <!-- Only the arrangement lives here; every colour, size and spacing comes from Look/Look.axaml. -->
  <Panel>
    <ScrollViewer x:Name="ContentScroller" HorizontalScrollBarVisibility="Disabled">
      <Border x:Name="ContentArea" Height="{Binding Bounds.Height, ElementName=ContentScroller}" MinHeight="{StaticResource Look.Height.ContentMin}">
      <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*" Margin="{StaticResource Look.Margin.Window}" MinWidth="700">

        <!-- Opening a statement, the message about one that wasn't opened, and the key figures -->
        <Border Classes="card" Grid.ColumnSpan="2">
          <StackPanel Spacing="{StaticResource Look.Space.Large}">
            <Grid ColumnDefinitions="*,Auto">
              <!-- Wraps in a narrow window instead of cutting a control off -->
              <WrapPanel>
                <!-- The two screens a statement is shown on -->
                <ListBox x:Name="ScreenSwitch" Classes="segmented" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}"
                         IsVisible="{Binding HasStatement}" VerticalAlignment="Center" Margin="{StaticResource Look.Margin.HeaderItem}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppScreenOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="OpenButton" Classes="secondary" Content="{x:Static vm:Texts.OpenStatement}" Command="{Binding OpenCommand}"
                        IsVisible="{Binding HasStatement}" VerticalAlignment="Center" Margin="{StaticResource Look.Margin.HeaderItem}" />
                <TextBlock Classes="muted" Text="{Binding Statement.Period}" VerticalAlignment="Center" IsVisible="{Binding HasStatement}"
                           Margin="{StaticResource Look.Margin.HeaderItem}" />
                <Border Classes="badge" IsVisible="{Binding IsExample}" VerticalAlignment="Center" Margin="{StaticResource Look.Margin.HeaderItem}">
                  <TextBlock Text="{x:Static vm:Texts.ExampleLabel}" />
                </Border>
                <TextBlock Classes="muted" Text="{x:Static vm:Texts.Reading}" VerticalAlignment="Center" IsVisible="{Binding IsReading}"
                           Margin="{StaticResource Look.Margin.HeaderItem}" />
              </WrapPanel>
              <!-- Light or dark: follow Windows, or always one of them -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Medium}">
                <TextBlock Classes="muted" Text="{x:Static vm:Texts.Look}" VerticalAlignment="Center" />
                <ListBox x:Name="LookSwitch" Classes="segmented" ItemsSource="{Binding Looks}" SelectedItem="{Binding SelectedLook}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="lookvm:LookOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Grid>
            <Border x:Name="OpenMessage" Classes="message error" IsVisible="{Binding OpenMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding OpenMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="close" Content="{x:Static vm:Texts.Close}" Command="{Binding CloseMessageCommand}" />
              </Grid>
            </Border>
            <Border x:Name="RulesMessage" Classes="message error" IsVisible="{Binding RulesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="*,Auto">
                <!-- Selectable, so the path of a moved-aside file can be copied. -->
                <SelectableTextBlock Text="{Binding RulesMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="close" Content="{x:Static vm:Texts.Close}" Command="{Binding CloseRulesMessageCommand}" />
              </Grid>
            </Border>
            <WrapPanel IsVisible="{Binding ShowsStatement}">
              <StackPanel Margin="{StaticResource Look.Margin.KeyFigure}">
                <TextBlock Classes="label" Text="{x:Static vm:Texts.SpendingTotal}" />
                <TextBlock Classes="keyNumber main" Text="{Binding Statement.SpendingTotal}" />
              </StackPanel>
              <StackPanel Margin="{StaticResource Look.Margin.KeyFigure}" VerticalAlignment="Bottom">
                <TextBlock Classes="label" Text="{x:Static vm:Texts.OpeningBalance}" />
                <TextBlock Classes="keyNumber" Text="{Binding Statement.OpeningBalance}" />
              </StackPanel>
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock Classes="label" Text="{x:Static vm:Texts.ClosingBalance}" />
                <TextBlock Classes="keyNumber" Text="{Binding Statement.ClosingBalance}" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- The start screen: what to do before any statement is open -->
        <Border x:Name="StartScreen" Classes="card start" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Top" IsVisible="{Binding !HasStatement}">
          <StackPanel Spacing="{StaticResource Look.Space.Medium}" HorizontalAlignment="Center">
            <TextBlock Classes="title" Text="{x:Static vm:Texts.StartHeading}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static vm:Texts.StartHint}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Classes="muted" Text="{x:Static vm:Texts.StartPrivacy}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Look.Space.Medium}" HorizontalAlignment="Center"
                        Margin="{StaticResource Look.Margin.StartButtons}">
              <Button Classes="primary" Content="{x:Static vm:Texts.OpenStatement}" Command="{Binding OpenCommand}" />
              <Button Classes="secondary" Content="{x:Static vm:Texts.TryExample}" Command="{Binding OpenExampleCommand}" IsVisible="{Binding HasExample}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- "Výpis": the key figures are in the header; here are the two charts, then the categories and transactions -->
        <Grid x:Name="StatementScreen" Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto,*" ColumnDefinitions="*,*" IsVisible="{Binding ShowsStatement}">

        <!-- The two charts -->
        <Border Classes="card" Grid.Row="0" Grid.Column="0">
          <DockPanel>
            <TextBlock Classes="heading" DockPanel.Dock="Top" Text="{x:Static vm:Texts.SpendingChart}" />
            <Panel Height="{StaticResource Look.Height.Chart}">
              <!-- The ring has a fixed square of its own, so a long legend never squeezes it. -->
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Statement.HasSpending}">
                <Panel Width="{StaticResource Look.Size.Ring}" Height="{StaticResource Look.Size.Ring}" VerticalAlignment="Center">
                  <lvc:PieChart x:Name="SpendingPie" LegendPosition="Hidden" TooltipPosition="Hidden" />
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Classes="label" Text="{x:Static vm:Texts.SpendingTotal}" HorizontalAlignment="Center" />
                    <TextBlock Classes="ringTotal" Text="{Binding Statement.SpendingTotal}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Panel>
                <ScrollViewer Grid.Column="1" Margin="{StaticResource Look.Margin.Legend}" VerticalAlignment="Center" MaxHeight="{StaticResource Look.Height.Chart}">
                  <ItemsControl x:Name="Legend" ItemsSource="{Binding Statement.Slices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PieSlice">
                        <Button Classes="legend" CommandParameter="{Binding Category}" ToolTip.Tip="{Binding Name}"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Statement.SelectCategoryCommand}">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Ellipse Classes="dot" Fill="{Binding Color, Converter={x:Static look:HexBrush.Instance}}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="label" Text="{Binding ShareText}" Margin="{StaticResource Look.Margin.Count}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding AmountText}" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
              <TextBlock Classes="empty" Text="{x:Static vm:Texts.NoSpending}" IsVisible="{Binding !Statement.HasSpending}" />
            </Panel>
          </DockPanel>
        </Border>
        <Border Classes="card" Grid.Row="0" Grid.Column="1">
          <DockPanel>
            <TextBlock Classes="heading" DockPanel.Dock="Top" Text="{x:Static vm:Texts.BalanceChart}" />
            <lvc:CartesianChart x:Name="BalanceLine" Height="{StaticResource Look.Height.Chart}" TooltipPosition="Hidden" />
          </DockPanel>
        </Border>

        <!-- Categories and the selected category's transactions -->
        <Border Classes="card" Grid.Row="1" Grid.Column="0">
          <DockPanel>
            <TextBlock Classes="heading" DockPanel.Dock="Top" Text="{x:Static vm:Texts.Categories}" />
            <ListBox ItemsSource="{Binding Statement.Categories}" SelectedItem="{Binding Statement.SelectedRow}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRow">
                  <Grid ColumnDefinitions="*,Auto,120">
                    <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="label" Text="{Binding Count}" Margin="{StaticResource Look.Margin.Count}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Total}" HorizontalAlignment="Right" Classes.incoming="{Binding IsIncoming}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Classes="card" Grid.Row="1" Grid.Column="1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Small}">
              <TextBlock Classes="heading" Text="{x:Static vm:Texts.Transactions}" />
              <TextBlock Classes="heading muted" Text="{Binding Statement.SelectedRow.Name, FallbackValue=''}" />
            </StackPanel>
            <Panel>
              <TextBlock Classes="empty" Text="{x:Static vm:Texts.NoCategorySelected}"
                         IsVisible="{Binding Statement.SelectedRow, Converter={x:Static ObjectConverters.IsNull}}" />
              <ListBox ItemsSource="{Binding Statement.Transactions}"
                       IsVisible="{Binding Statement.SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TransactionRow">
                    <Grid ColumnDefinitions="90,*,*,110">
                      <TextBlock Classes="muted" Text="{Binding Date}" />
                      <TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Look.Margin.Gap}" />
                      <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Subcategory}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding Amount}" HorizontalAlignment="Right" Classes.incoming="{Binding IsIncoming}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </DockPanel>
        </Border>

        </Grid>

        <!-- "Pravidlá": a new rule, and the saved ones -->
        <Grid x:Name="RulesScreen" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" IsVisible="{Binding ShowsRules}">
        <Border Classes="card" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
          <StackPanel Spacing="{StaticResource Look.Space.Medium}">
            <TextBlock x:Name="FormHeading" Classes="heading" Text="{Binding RuleForm.Heading}" />
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Look.Space.Medium}">
              <TextBlock Classes="muted" Text="{x:Static vm:Texts.Condition}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="{StaticResource Look.Space.Medium}">
                <ComboBox ItemsSource="{Binding RuleForm.Kinds}" SelectedItem="{Binding RuleForm.SelectedKindOption}" MinWidth="200">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:KindOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel x:Name="TextFields" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Medium}" IsVisible="{Binding RuleForm.IsText}">
                  <ComboBox ItemsSource="{Binding RuleForm.TextModes}" SelectedItem="{Binding RuleForm.SelectedTextMode}" MinWidth="120">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:TextModeOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Text="{Binding RuleForm.Text}" MinWidth="240" />
                </StackPanel>
                <StackPanel x:Name="AmountFields" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Medium}" IsVisible="{Binding RuleForm.IsAmount}">
                  <TextBlock Classes="muted" Text="{x:Static vm:Texts.AmountFrom}" VerticalAlignment="Center" />
                  <TextBox Text="{Binding RuleForm.AmountFrom}" Width="110" />
                  <TextBlock Classes="muted" Text="{x:Static vm:Texts.AmountTo}" VerticalAlignment="Center" />
                  <TextBox Text="{Binding RuleForm.AmountTo}" Width="110" />
                  <TextBlock Classes="muted" Text="€" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox x:Name="AccountField" Text="{Binding RuleForm.Account}" MinWidth="300" IsVisible="{Binding RuleForm.IsAccount}" />
                <ItemsControl x:Name="TypeChoices" ItemsSource="{Binding RuleForm.Types}" IsVisible="{Binding RuleForm.IsType}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TypeChoice">
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="SymbolField" Text="{Binding RuleForm.Symbol}" MinWidth="200" IsVisible="{Binding RuleForm.IsSymbol}" />
              </StackPanel>

              <TextBlock Grid.Row="1" Classes="muted" Text="{x:Static vm:Texts.TargetCategory}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RuleForm.Categories}"
                        SelectedItem="{Binding RuleForm.SelectedCategory}" MinWidth="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="cat:Category">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="2" Classes="muted" Text="{x:Static vm:Texts.TargetSubcategory}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RuleForm.Subcategories}"
                        SelectedItem="{Binding RuleForm.SelectedSubcategory}" MinWidth="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="cat:Subcategory">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="3" Classes="muted" Text="{x:Static vm:Texts.Priority}" VerticalAlignment="Center" IsVisible="{Binding RuleForm.IsEditing}" />
              <StackPanel x:Name="PriorityRow" Grid.Row="3" Grid.Column="1" Classes="headingRow" IsVisible="{Binding RuleForm.IsEditing}">
                <TextBox x:Name="PriorityField" Text="{Binding RuleForm.Priority}" Width="80" />
                <Button x:Name="PriorityHelp" Classes="help" Content="?" ToolTip.Tip="{x:Static vm:Texts.PriorityHelp}" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Enter presses the default button; while a rule is open, AddRule saves it -->
              <Button x:Name="AddRuleButton" Grid.Row="4" Grid.Column="1" Classes="primary" Content="{x:Static vm:Texts.AddRule}"
                      Command="{Binding AddRuleCommand}" IsDefault="True" IsVisible="{Binding !RuleForm.IsEditing}" />
              <StackPanel x:Name="EditButtons" Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Medium}"
                          IsVisible="{Binding RuleForm.IsEditing}">
                <Button Classes="primary" Content="{x:Static vm:Texts.SaveRule}" Command="{Binding SaveRuleCommand}" />
                <Button Classes="secondary" Content="{x:Static vm:Texts.CancelEdit}" Command="{Binding CancelEditCommand}" />
              </StackPanel>
            </Grid>
            <Border Classes="message confirmation" IsVisible="{Binding RuleForm.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding RuleForm.Message}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="message error" IsVisible="{Binding RuleForm.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding RuleForm.Error}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="card" Grid.Row="0" Grid.Column="1">
          <DockPanel>
            <!-- The heading is a pair of pills: the user's own rules (at start) or the built-in ones -->
            <ListBox x:Name="RuleViewSwitch" Classes="segmented tabs" DockPanel.Dock="Top" HorizontalAlignment="Left"
                     ItemsSource="{Binding RuleViews}" SelectedItem="{Binding SelectedRuleView}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleViewOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Classes="message error" DockPanel.Dock="Top"
                    x:Name="RulesNotSaving" IsVisible="{Binding RulesNotSaving}">
              <TextBlock Text="{x:Static vm:Texts.RulesNotSaving}" TextWrapping="Wrap" />
            </Border>

            <!-- The user's own rules, in the order they are tried -->
            <DockPanel x:Name="MyRules" IsVisible="{Binding !IsBuiltInView}">
              <Border Classes="message confirmation" DockPanel.Dock="Top" x:Name="RulesListMessage"
                      IsVisible="{Binding RulesListMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding RulesListMessage}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="message error" DockPanel.Dock="Top" x:Name="RulesListError"
                      IsVisible="{Binding RulesListError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding RulesListError}" TextWrapping="Wrap" />
              </Border>
              <Panel>
                <TextBlock Classes="empty" Text="{x:Static vm:Texts.NoRules}" IsVisible="{Binding !Rules.Count}" />
                <ScrollViewer Classes="ruleList">
                  <ItemsControl x:Name="RuleList" ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RuleRow">
                        <Border Classes="ruleRow" Classes.editing="{Binding IsEditing}">
                          <Grid ColumnDefinitions="*,*,Auto">
                            <TextBlock Text="{Binding Condition}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Look.Margin.Gap}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Target}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Look.Margin.Gap}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Small}">
                              <Button Classes="small secondary" Content="{x:Static vm:Texts.Edit}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditRuleCommand}" CommandParameter="{Binding}" />
                              <Button Classes="small secondary" Content="{x:Static vm:Texts.Delete}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AskToDeleteCommand}" CommandParameter="{Binding}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>
            </DockPanel>

            <!-- The built-in rules, read only, in the order they are tried -->
            <ScrollViewer Classes="ruleList" x:Name="BuiltInRules" IsVisible="{Binding IsBuiltInView}">
              <ItemsControl x:Name="BuiltInRuleList" ItemsSource="{Binding BuiltInRules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RuleRow">
                    <Border Classes="ruleRow">
                      <Grid ColumnDefinitions="*,*">
                        <TextBlock Text="{Binding Condition}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Look.Margin.Gap}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Target}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
        </Grid>

      </Grid>
      </Border>
    </ScrollViewer>

    <!-- The charts' hover cards and the dot on the balance line. Above the content, so nothing cuts a card; it lets the pointer through to the charts. -->
    <Canvas x:Name="HoverLayer" IsHitTestVisible="False">
      <Border x:Name="RingCard" Classes="hoverCard" IsVisible="False">
        <StackPanel>
          <TextBlock x:Name="RingCardName" Classes="name" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="RingCardAmount" />
        </StackPanel>
      </Border>
      <Border x:Name="BalanceCard" Classes="hoverCard" IsVisible="False">
        <StackPanel>
          <TextBlock x:Name="BalanceCardDate" Classes="name" />
          <TextBlock x:Name="BalanceCardBalance" />
        </StackPanel>
      </Border>
      <Ellipse x:Name="HoverDot" Classes="hoverDot" IsVisible="False" />
    </Canvas>

    <!-- "Odstrániť toto pravidlo?": a pop-up over the dimmed window, which waits until it is answered -->
    <Panel x:Name="DeleteDialog" IsVisible="{Binding RuleToDelete, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="scrim" />
      <Border x:Name="DeleteDialogBox" Classes="card dialog" KeyboardNavigation.TabNavigation="Cycle" Focusable="True" FocusAdorner="{x:Null}">
        <StackPanel Spacing="{StaticResource Look.Space.Medium}">
          <TextBlock Classes="heading" Text="{x:Static vm:Texts.DeleteQuestion}" />
          <TextBlock x:Name="DeleteDialogRule" Text="{Binding RuleToDelete.Condition, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding RuleToDelete.Target, FallbackValue=''}" TextWrapping="Wrap" />
          <StackPanel Classes="dialogButtons">
            <Button x:Name="DeleteDialogDelete" Classes="primary" Content="{x:Static vm:Texts.Delete}" Command="{Binding DeleteRuleCommand}" />
            <Button x:Name="DeleteDialogKeep" Classes="secondary" Content="{x:Static vm:Texts.Keep}" Command="{Binding KeepRuleCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- While a file is dragged over the window. It lets the drop through to the window. -->
    <Border x:Name="DropOverlay" Classes="dropOverlay" IsVisible="{Binding IsDraggingOver}" IsHitTestVisible="False">
      <TextBlock Classes="title" Text="{x:Static vm:Texts.DropHere}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Panel>
</Window>
