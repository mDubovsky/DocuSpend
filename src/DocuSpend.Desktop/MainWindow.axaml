<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DocuSpend.Presentation"
        xmlns:cat="using:DocuSpend.Categorization.Model"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:look="using:DocuSpend.Desktop.Look"
        xmlns:lookvm="using:DocuSpend.Presentation.Look"
        xmlns:local="using:DocuSpend.Desktop"
        x:Class="DocuSpend.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static vm:Texts.AppTitle}"
        Width="1280" Height="940" MinWidth="720" MinHeight="520"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <!-- Which of a transaction row's controls show (work/022-categorize-from-list/spec.md: the mark and undoing it).
         Only visibility is set here; the look of each comes from Look/Look.axaml. -->
    <Style Selector="ListBox#TransactionList Button.rowAction">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox#TransactionList ListBoxItem:selected Button.rowAction">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBox#TransactionList Panel.handMark:pointerover Button.undo">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBox#TransactionList Panel.handMark:pointerover Border.byHand">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox#TransactionList ListBoxItem:selected Border.byHand">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The selected row is the open row, which shows its details (work/045-transaction-details/spec.md) -->
    <Style Selector="ListBox#TransactionList ItemsControl.details">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox#TransactionList ListBoxItem:selected ItemsControl.details">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <!-- Escape closes the box on top: the box about fingerprints, the "Zaradiť" box, or "Odstrániť toto pravidlo?" -->
    <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
  </Window.KeyBindings>

  <!-- Only the arrangement lives here; every colour, size and spacing comes from Look/Look.axaml. -->
  <Panel>
    <ScrollViewer x:Name="ContentScroller" HorizontalScrollBarVisibility="Disabled">
      <Border x:Name="ContentArea" Height="{Binding Bounds.Height, ElementName=ContentScroller}" MinHeight="{StaticResource Look.Height.ContentMin}">
      <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*" Margin="{StaticResource Look.Margin.Window}" MinWidth="700">

        <!-- Opening a statement, the message about one that wasn't opened, and the key figures -->
        <Border Classes="card" Grid.ColumnSpan="2">
          <StackPanel Spacing="{StaticResource Look.Space.Large}">
            <Grid ColumnDefinitions="*,Auto,*">
              <!-- Left: opening a statement and what is open. Wraps in a narrow window instead of cutting a control off. -->
              <WrapPanel>
                <Button x:Name="OpenButton" Classes="secondary" Content="{x:Static vm:Texts.OpenStatement}" Command="{Binding OpenCommand}"
                        IsVisible="{Binding HasStatement}" VerticalAlignment="Center" Margin="{StaticResource Look.Margin.HeaderItem}" />
                <TextBlock Classes="muted" Text="{Binding Statement.Period}" VerticalAlignment="Center" IsVisible="{Binding HasStatement}"
                           Margin="{StaticResource Look.Margin.HeaderItem}" />
                <Border Classes="badge" IsVisible="{Binding IsExample}" VerticalAlignment="Center" Margin="{StaticResource Look.Margin.HeaderItem}">
                  <TextBlock Text="{x:Static vm:Texts.ExampleLabel}" />
                </Border>
                <TextBlock Classes="muted" Text="{x:Static vm:Texts.Reading}" VerticalAlignment="Center" IsVisible="{Binding IsReading}"
                           Margin="{StaticResource Look.Margin.HeaderItem}" />
              </WrapPanel>
              <!-- Middle: the two screens a statement is shown on -->
              <ListBox x:Name="ScreenSwitch" Grid.Column="1" Classes="segmented" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}"
                       IsVisible="{Binding HasStatement}" VerticalAlignment="Center" Margin="{StaticResource Look.Margin.HeaderCentre}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AppScreenOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <!-- Light or dark: follow Windows, or always one of them -->
              <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Classes="muted" Text="{x:Static vm:Texts.Look}" VerticalAlignment="Center" Margin="{StaticResource Look.Margin.HeaderItem}" />
                <ListBox x:Name="LookSwitch" Classes="segmented" ItemsSource="{Binding Looks}" SelectedItem="{Binding SelectedLook}" VerticalAlignment="Center">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="lookvm:LookOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </WrapPanel>
            </Grid>
            <Border x:Name="OpenMessage" Classes="message error" IsVisible="{Binding OpenMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding OpenMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="close" Content="{x:Static vm:Texts.Close}" Command="{Binding CloseMessageCommand}" />
              </Grid>
            </Border>
            <Border x:Name="RulesMessage" Classes="message error" IsVisible="{Binding RulesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid ColumnDefinitions="*,Auto">
                <!-- Selectable, so the path of a moved-aside file can be copied. -->
                <SelectableTextBlock Text="{Binding RulesMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="close" Content="{x:Static vm:Texts.Close}" Command="{Binding CloseRulesMessageCommand}" />
              </Grid>
            </Border>
            <Grid IsVisible="{Binding ShowsStatement}" ColumnDefinitions="*,Auto">
            <WrapPanel>
              <StackPanel Margin="{StaticResource Look.Margin.KeyFigure}">
                <TextBlock Classes="label" Text="{x:Static vm:Texts.SpendingTotal}" />
                <TextBlock Classes="keyNumber main" Text="{Binding Statement.SpendingTotal}" />
              </StackPanel>
              <StackPanel Margin="{StaticResource Look.Margin.KeyFigure}" VerticalAlignment="Bottom">
                <TextBlock Classes="label" Text="{x:Static vm:Texts.OpeningBalance}" />
                <TextBlock Classes="keyNumber" Text="{Binding Statement.OpeningBalance}" />
              </StackPanel>
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock Classes="label" Text="{x:Static vm:Texts.ClosingBalance}" />
                <TextBlock Classes="keyNumber" Text="{Binding Statement.ClosingBalance}" />
              </StackPanel>
            </WrapPanel>
            <!-- Transactions of types DocuSpend doesn't know yet: a quiet note, only when there are some -->
            <StackPanel x:Name="UnknownTypes" Grid.Column="1" Classes="headingRow" VerticalAlignment="Bottom"
                        IsVisible="{Binding Statement.UnknownTypes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="muted" Text="{Binding Statement.UnknownTypes}" VerticalAlignment="Center" />
              <Button x:Name="UnknownTypesHelp" Classes="help" Content="?" ToolTip.Tip="{x:Static vm:Texts.UnknownTypesHelp}" VerticalAlignment="Center" />
            </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- The start screen: what to do before any statement is open -->
        <Border x:Name="StartScreen" Classes="card start" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Top" IsVisible="{Binding !HasStatement}">
          <StackPanel Spacing="{StaticResource Look.Space.Medium}" HorizontalAlignment="Center">
            <TextBlock Classes="title" Text="{x:Static vm:Texts.StartHeading}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static vm:Texts.StartHint}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Classes="muted" Text="{x:Static vm:Texts.StartPrivacy}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Look.Space.Medium}" HorizontalAlignment="Center"
                        Margin="{StaticResource Look.Margin.StartButtons}">
              <Button Classes="primary" Content="{x:Static vm:Texts.OpenStatement}" Command="{Binding OpenCommand}" />
              <Button Classes="secondary" Content="{x:Static vm:Texts.TryExample}" Command="{Binding OpenExampleCommand}" IsVisible="{Binding HasExample}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- "Výpis": the key figures are in the header; here are the two charts, then the categories and transactions -->
        <Grid x:Name="StatementScreen" Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto,*" ColumnDefinitions="*,*" IsVisible="{Binding ShowsStatement}">

        <!-- The two charts -->
        <Border Classes="card" Grid.Row="0" Grid.Column="0">
          <DockPanel>
            <TextBlock Classes="heading" DockPanel.Dock="Top" Text="{x:Static vm:Texts.SpendingChart}" />
            <Panel Height="{StaticResource Look.Height.Chart}">
              <!-- The ring has a fixed square of its own, so a long legend never squeezes it. -->
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Statement.HasSpending}">
                <Panel Width="{StaticResource Look.Size.Ring}" Height="{StaticResource Look.Size.Ring}" VerticalAlignment="Center">
                  <lvc:PieChart x:Name="SpendingPie" LegendPosition="Hidden" TooltipPosition="Hidden" />
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Classes="label" Text="{x:Static vm:Texts.SpendingTotal}" HorizontalAlignment="Center" />
                    <TextBlock Classes="ringTotal" Text="{Binding Statement.SpendingTotal}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Panel>
                <ScrollViewer Grid.Column="1" Margin="{StaticResource Look.Margin.Legend}" VerticalAlignment="Center" MaxHeight="{StaticResource Look.Height.Chart}">
                  <ItemsControl x:Name="Legend" ItemsSource="{Binding Statement.Slices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PieSlice">
                        <Button Classes="legend" CommandParameter="{Binding Category}" ToolTip.Tip="{Binding Name}"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Statement.SelectCategoryCommand}">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Ellipse Classes="dot" Fill="{Binding Color, Converter={x:Static look:HexBrush.Instance}}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="label" Text="{Binding ShareText}" Margin="{StaticResource Look.Margin.Count}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding AmountText}" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
              <TextBlock Classes="empty" Text="{x:Static vm:Texts.NoSpending}" IsVisible="{Binding !Statement.HasSpending}" />
            </Panel>
          </DockPanel>
        </Border>
        <Border Classes="card" Grid.Row="0" Grid.Column="1">
          <DockPanel>
            <TextBlock Classes="heading" DockPanel.Dock="Top" Text="{x:Static vm:Texts.BalanceChart}" />
            <lvc:CartesianChart x:Name="BalanceLine" Height="{StaticResource Look.Height.Chart}" TooltipPosition="Hidden" />
          </DockPanel>
        </Border>

        <!-- Categories and the selected category's transactions -->
        <Border Classes="card" Grid.Row="1" Grid.Column="0">
          <DockPanel>
            <TextBlock Classes="heading" DockPanel.Dock="Top" Text="{x:Static vm:Texts.Categories}" />
            <ListBox ItemsSource="{Binding Statement.Categories}" SelectedItem="{Binding Statement.SelectedRow}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRow">
                  <Grid ColumnDefinitions="*,Auto,120">
                    <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="label" Text="{Binding Count}" Margin="{StaticResource Look.Margin.Count}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Total}" HorizontalAlignment="Right" Classes.incoming="{Binding IsIncoming}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Classes="card" Grid.Row="1" Grid.Column="1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Small}">
              <TextBlock Classes="heading" Text="{x:Static vm:Texts.Transactions}" />
              <TextBlock Classes="heading muted" Text="{Binding Statement.SelectedRow.Name, FallbackValue=''}" />
            </StackPanel>
            <!-- What the last change made from the list did, and whether it will be kept -->
            <Border x:Name="TransactionsMessage" Classes="message confirmation" DockPanel.Dock="Top"
                    IsVisible="{Binding Statement.TransactionsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding Statement.TransactionsMessage}" TextWrapping="Wrap" />
            </Border>
            <Border x:Name="TransactionsError" Classes="message error" DockPanel.Dock="Top"
                    IsVisible="{Binding Statement.TransactionsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding Statement.TransactionsError}" TextWrapping="Wrap" />
            </Border>
            <Panel>
              <TextBlock Classes="empty" Text="{x:Static vm:Texts.NoCategorySelected}"
                         IsVisible="{Binding Statement.SelectedRow, Converter={x:Static ObjectConverters.IsNull}}" />
              <!-- A selected row is open: it shows its details and "Zaradiť"; a hand-chosen one shows "ručne", which turns
                   into "× Zrušiť zaradenie" when pointed at or when the row is selected (the styles at the top of this
                   file). Toggle selection folds the open row on a second click, Space or Enter. -->
              <ListBox x:Name="TransactionList" ItemsSource="{Binding Statement.Transactions}" SelectedItem="{Binding Statement.SelectedTransaction}"
                       SelectionMode="Single,Toggle"
                       IsVisible="{Binding Statement.SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TransactionRow">
                    <Grid ColumnDefinitions="90,*,*,Auto,110" RowDefinitions="Auto,Auto">
                      <TextBlock Classes="muted" Text="{Binding Date}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Look.Margin.Gap}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Subcategory}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Small}" Margin="{StaticResource Look.Margin.Gap}">
                        <Panel Classes="handMark" Background="Transparent" IsVisible="{Binding ByHand}" ToolTip.Tip="{x:Static vm:Texts.ByHandTooltip}">
                          <Border Classes="tag byHand">
                            <TextBlock Text="{x:Static vm:Texts.ByHandTag}" />
                          </Border>
                          <Button Classes="small secondary rowAction undo" Content="{x:Static vm:Texts.UndoHandChoice}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).UndoHandChoiceCommand}" CommandParameter="{Binding}" />
                        </Panel>
                        <Button Classes="small primary rowAction categorize" Content="{x:Static vm:Texts.Categorize}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CategorizeCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                      <TextBlock Grid.Column="4" Text="{Binding Amount}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes.incoming="{Binding IsIncoming}" />
                      <!-- The details, under the description; the labels share one width -->
                      <ItemsControl x:Name="TransactionDetails" Classes="details" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                    ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TransactionDetail">
                            <Grid Classes="detail" Classes.groupStart="{Binding StartsGroup}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DetailLabel" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Classes="muted detailLabel" Text="{Binding Label}" />
                              <TextBlock Grid.Column="1" Classes="detailValue" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </DockPanel>
        </Border>

        </Grid>

        <!-- "Pravidlá": a new rule, and the saved ones -->
        <Grid x:Name="RulesScreen" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" IsVisible="{Binding ShowsRules}">
        <Border Classes="card" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
          <StackPanel Spacing="{StaticResource Look.Space.Medium}">
            <TextBlock x:Name="FormHeading" Classes="heading" Text="{Binding RuleForm.Heading}" />
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Look.Space.Medium}">
              <TextBlock Classes="muted" Text="{x:Static vm:Texts.Condition}" VerticalAlignment="Center" />
              <local:ConditionFields x:Name="RuleConditionFields" Grid.Column="1" DataContext="{Binding RuleForm}" />

              <TextBlock Grid.Row="1" Classes="muted" Text="{x:Static vm:Texts.TargetCategory}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RuleForm.Categories}"
                        SelectedItem="{Binding RuleForm.SelectedCategory}" MinWidth="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="cat:Category">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="2" Classes="muted" Text="{x:Static vm:Texts.TargetSubcategory}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RuleForm.Subcategories}"
                        SelectedItem="{Binding RuleForm.SelectedSubcategory}" MinWidth="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="cat:Subcategory">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="3" Classes="muted" Text="{x:Static vm:Texts.Priority}" VerticalAlignment="Center" IsVisible="{Binding RuleForm.IsEditing}" />
              <StackPanel x:Name="PriorityRow" Grid.Row="3" Grid.Column="1" Classes="headingRow" IsVisible="{Binding RuleForm.IsEditing}">
                <TextBox x:Name="PriorityField" Text="{Binding RuleForm.Priority}" Width="80" />
                <Button x:Name="PriorityHelp" Classes="help" Content="?" ToolTip.Tip="{x:Static vm:Texts.PriorityHelp}" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Enter presses the default button; while a rule is open, AddRule saves it -->
              <Button x:Name="AddRuleButton" Grid.Row="4" Grid.Column="1" Classes="primary" Content="{x:Static vm:Texts.AddRule}"
                      Command="{Binding AddRuleCommand}" IsDefault="True" IsVisible="{Binding !RuleForm.IsEditing}" />
              <StackPanel x:Name="EditButtons" Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Medium}"
                          IsVisible="{Binding RuleForm.IsEditing}">
                <Button Classes="primary" Content="{x:Static vm:Texts.SaveRule}" Command="{Binding SaveRuleCommand}" />
                <Button Classes="secondary" Content="{x:Static vm:Texts.CancelEdit}" Command="{Binding CancelEditCommand}" />
              </StackPanel>
            </Grid>
            <Border Classes="message confirmation" IsVisible="{Binding RuleForm.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding RuleForm.Message}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="message error" IsVisible="{Binding RuleForm.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding RuleForm.Error}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="card" Grid.Row="0" Grid.Column="1">
          <DockPanel>
            <!-- The heading is a pair of pills: the user's own rules (at start) or the built-in ones -->
            <ListBox x:Name="RuleViewSwitch" Classes="segmented tabs" DockPanel.Dock="Top" HorizontalAlignment="Left"
                     ItemsSource="{Binding RuleViews}" SelectedItem="{Binding SelectedRuleView}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleViewOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Classes="message error" DockPanel.Dock="Top"
                    x:Name="RulesNotSaving" IsVisible="{Binding RulesNotSaving}">
              <TextBlock Text="{x:Static vm:Texts.RulesNotSaving}" TextWrapping="Wrap" />
            </Border>

            <!-- The user's own rules, in the order they are tried -->
            <DockPanel x:Name="MyRules" IsVisible="{Binding !IsBuiltInView}">
              <Border Classes="message confirmation" DockPanel.Dock="Top" x:Name="RulesListMessage"
                      IsVisible="{Binding RulesListMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding RulesListMessage}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="message error" DockPanel.Dock="Top" x:Name="RulesListError"
                      IsVisible="{Binding RulesListError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding RulesListError}" TextWrapping="Wrap" />
              </Border>
              <Panel>
                <TextBlock Classes="empty" Text="{x:Static vm:Texts.NoRules}" IsVisible="{Binding !Rules.Count}" />
                <ScrollViewer Classes="ruleList">
                  <ItemsControl x:Name="RuleList" ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RuleRow">
                        <Border Classes="ruleRow" Classes.editing="{Binding IsEditing}">
                          <Grid ColumnDefinitions="*,*,Auto">
                            <TextBlock Text="{Binding Condition}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Look.Margin.Gap}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Target}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Look.Margin.Gap}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Small}">
                              <Button Classes="small secondary" Content="{x:Static vm:Texts.Edit}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditRuleCommand}" CommandParameter="{Binding}" />
                              <Button Classes="small secondary" Content="{x:Static vm:Texts.Delete}"
                                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AskToDeleteCommand}" CommandParameter="{Binding}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>
            </DockPanel>

            <!-- The built-in rules, read only, in the order they are tried -->
            <ScrollViewer Classes="ruleList" x:Name="BuiltInRules" IsVisible="{Binding IsBuiltInView}">
              <ItemsControl x:Name="BuiltInRuleList" ItemsSource="{Binding BuiltInRules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RuleRow">
                    <Border Classes="ruleRow">
                      <Grid ColumnDefinitions="*,*">
                        <TextBlock Text="{Binding Condition}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Look.Margin.Gap}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Target}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
        </Grid>

        <!-- "Kategórie": the list of categories, and the chosen one's details or the form for a new one -->
        <Grid x:Name="CategoriesScreen" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="2*,3*" IsVisible="{Binding ShowsCategories}">
        <Border Classes="card" Grid.Column="0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="{StaticResource Look.Margin.Heading}">
              <TextBlock Classes="heading plain" Text="{x:Static vm:Texts.Categories}" VerticalAlignment="Center" />
              <Button x:Name="NewCategoryButton" Grid.Column="1" Classes="secondary" Content="{x:Static vm:Texts.NewCategory}"
                      Command="{Binding Categories.StartNewCategoryCommand}" />
            </Grid>
            <Border Classes="message error" DockPanel.Dock="Top" x:Name="CategoriesNotSaving" IsVisible="{Binding RulesNotSaving}" Margin="{StaticResource Look.Margin.Heading}">
              <TextBlock Text="{x:Static vm:Texts.RulesNotSaving}" TextWrapping="Wrap" />
            </Border>
            <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories.Rows}" SelectedItem="{Binding Categories.SelectedRow}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryItem">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="tag own" IsVisible="{Binding IsOwn}">
                      <TextBlock Text="{x:Static vm:Texts.Own}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Border Classes="card" Grid.Column="1">
          <Panel>
            <!-- The chosen category: its role, its sub-categories, and a field for a new one -->
            <ScrollViewer x:Name="CategoryDetails" IsVisible="{Binding Categories.ShowsDetails}">
              <StackPanel Spacing="{StaticResource Look.Space.Medium}">
                <StackPanel>
                  <StackPanel Classes="headingRow">
                    <TextBlock x:Name="CategoryDetailsName" Classes="heading plain" Text="{Binding Categories.SelectedRow.Name, FallbackValue=''}" VerticalAlignment="Center" />
                    <Border Classes="tag own" IsVisible="{Binding Categories.SelectedRow.IsOwn, FallbackValue=False}">
                      <TextBlock Text="{x:Static vm:Texts.Own}" />
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="CategoryDetailsRole" Classes="muted" Text="{Binding Categories.SelectedRow.RoleText, FallbackValue=''}" />
                </StackPanel>
                <Border Classes="message confirmation" x:Name="CategoriesMessage"
                        IsVisible="{Binding Categories.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Categories.Message}" TextWrapping="Wrap" />
                </Border>
                <Border Classes="message error" x:Name="CategoriesError"
                        IsVisible="{Binding Categories.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Categories.Error}" TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="UncategorizedNote" Classes="muted" Text="{x:Static vm:Texts.UncategorizedNote}" TextWrapping="Wrap"
                           IsVisible="{Binding !Categories.SelectedRow.CanAddSubcategory, FallbackValue=False}" />
                <StackPanel x:Name="SubcategoryPart" IsVisible="{Binding Categories.SelectedRow.CanAddSubcategory, FallbackValue=False}" Spacing="{StaticResource Look.Space.Small}">
                  <TextBlock Classes="label" Text="{x:Static vm:Texts.Subcategories}" />
                  <ItemsControl x:Name="SubcategoryList" ItemsSource="{Binding Categories.SelectedRow.Subcategories, FallbackValue={x:Null}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SubcategoryItem">
                        <Border Classes="subcategoryRow">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Classes="headingRow">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <TextBlock Classes="muted" Text="{x:Static vm:Texts.OtherHint}" IsVisible="{Binding IsOther}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="tag own" IsVisible="{Binding IsOwn}">
                              <TextBlock Text="{x:Static vm:Texts.Own}" />
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Look.Space.Medium}">
                    <TextBox x:Name="SubcategoryNameField" Text="{Binding Categories.SubcategoryName}" MaxLength="{x:Static vm:Texts.MaxNameLength}"
                             Watermark="{x:Static vm:Texts.NewSubcategory}" />
                    <Button x:Name="AddSubcategoryButton" Grid.Column="1" Classes="secondary" Content="{x:Static vm:Texts.AddSubcategory}"
                            Command="{Binding AddSubcategoryCommand}" />
                  </Grid>
                  <TextBlock x:Name="SubcategoryError" Classes="fieldError" Text="{Binding Categories.SubcategoryError}" TextWrapping="Wrap"
                             IsVisible="{Binding Categories.SubcategoryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- "Nová kategória": shown only when asked for, in place of the details -->
            <StackPanel x:Name="NewCategoryForm" IsVisible="{Binding Categories.IsAddingCategory}" Spacing="{StaticResource Look.Space.Medium}">
              <TextBlock Classes="heading" Text="{x:Static vm:Texts.NewCategory}" />
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Look.Space.Medium}">
                <TextBlock Classes="muted" Text="{x:Static vm:Texts.CategoryName}" VerticalAlignment="Top" Margin="{StaticResource Look.Margin.FieldLabel}" />
                <StackPanel Grid.Column="1" Spacing="{StaticResource Look.Space.Small}">
                  <TextBox x:Name="CategoryNameField" Text="{Binding Categories.NewName}" MaxLength="{x:Static vm:Texts.MaxNameLength}" MinWidth="300" HorizontalAlignment="Left" />
                  <TextBlock x:Name="CategoryNameError" Classes="fieldError" Text="{Binding Categories.NameError}" TextWrapping="Wrap"
                             IsVisible="{Binding Categories.NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Classes="muted" Text="{x:Static vm:Texts.CountsAs}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Classes="headingRow">
                  <ComboBox x:Name="RoleChoice" ItemsSource="{Binding Categories.Roles}" SelectedItem="{Binding Categories.SelectedRole}" MinWidth="200">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:RoleOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button x:Name="RoleHelp" Classes="help" Content="?" ToolTip.Tip="{x:Static vm:Texts.RoleHelp}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Look.Space.Medium}">
                  <Button x:Name="AddCategoryButton" Classes="primary" Content="{x:Static vm:Texts.AddCategory}" Command="{Binding AddCategoryCommand}" />
                  <Button x:Name="CancelNewCategoryButton" Classes="secondary" Content="{x:Static vm:Texts.CancelEdit}"
                          Command="{Binding Categories.CancelNewCategoryCommand}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Panel>
        </Border>
        </Grid>

      </Grid>
      </Border>
    </ScrollViewer>

    <!-- The charts' hover cards and the dot on the balance line. Above the content, so nothing cuts a card; it lets the pointer through to the charts. -->
    <Canvas x:Name="HoverLayer" IsHitTestVisible="False">
      <Border x:Name="RingCard" Classes="hoverCard" IsVisible="False">
        <StackPanel>
          <TextBlock x:Name="RingCardName" Classes="name" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="RingCardAmount" />
        </StackPanel>
      </Border>
      <Border x:Name="BalanceCard" Classes="hoverCard" IsVisible="False">
        <StackPanel>
          <TextBlock x:Name="BalanceCardDate" Classes="name" />
          <TextBlock x:Name="BalanceCardBalance" />
        </StackPanel>
      </Border>
      <Ellipse x:Name="HoverDot" Classes="hoverDot" IsVisible="False" />
    </Canvas>

    <!-- "Odstrániť toto pravidlo?": a pop-up over the dimmed window, which waits until it is answered -->
    <Panel x:Name="DeleteDialog" IsVisible="{Binding RuleToDelete, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="scrim" />
      <Border x:Name="DeleteDialogBox" Classes="card dialog" KeyboardNavigation.TabNavigation="Cycle" Focusable="True" FocusAdorner="{x:Null}">
        <StackPanel Spacing="{StaticResource Look.Space.Medium}">
          <TextBlock Classes="heading" Text="{x:Static vm:Texts.DeleteQuestion}" />
          <TextBlock x:Name="DeleteDialogRule" Text="{Binding RuleToDelete.Condition, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding RuleToDelete.Target, FallbackValue=''}" TextWrapping="Wrap" />
          <StackPanel Classes="dialogButtons">
            <Button x:Name="DeleteDialogDelete" Classes="primary" Content="{x:Static vm:Texts.Delete}" Command="{Binding DeleteRuleCommand}" />
            <Button x:Name="DeleteDialogKeep" Classes="secondary" Content="{x:Static vm:Texts.Keep}" Command="{Binding KeepRuleCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- "Zaradiť transakciu": a pop-up over the dimmed window, filled in from the transaction (work/022-categorize-from-list/spec.md) -->
    <Panel x:Name="CategorizeDialog" IsVisible="{Binding Categorizing, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="scrim" />
      <Border x:Name="CategorizeDialogBox" Classes="card dialog" KeyboardNavigation.TabNavigation="Cycle" Focusable="True" FocusAdorner="{x:Null}">
        <StackPanel Spacing="{StaticResource Look.Space.Medium}">
          <TextBlock Classes="heading" Text="{x:Static vm:Texts.CategorizeHeading}" />
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Look.Space.Medium}">
            <TextBlock Classes="muted" Text="{Binding Categorizing.Date, FallbackValue=''}" />
            <TextBlock x:Name="CategorizeDialogDescription" Grid.Column="1" Text="{Binding Categorizing.Row.Description, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Categorizing.Row.Amount, FallbackValue=''}" />
          </Grid>
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Look.Space.Medium}">
            <TextBlock Classes="muted" Text="{x:Static vm:Texts.TargetCategory}" VerticalAlignment="Center" />
            <ComboBox x:Name="CategorizeCategory" Grid.Column="1" ItemsSource="{Binding Categorizing.Form.Categories, FallbackValue={x:Null}}"
                      SelectedItem="{Binding Categorizing.Form.SelectedCategory, FallbackValue={x:Null}}" MinWidth="300">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="cat:Category">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Classes="muted" Text="{x:Static vm:Texts.TargetSubcategory}" VerticalAlignment="Center" />
            <ComboBox x:Name="CategorizeSubcategory" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Categorizing.Form.Subcategories, FallbackValue={x:Null}}"
                      SelectedItem="{Binding Categorizing.Form.SelectedSubcategory, FallbackValue={x:Null}}" MinWidth="300">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="cat:Subcategory">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <RadioButton x:Name="JustThisChoice" GroupName="CategorizeScope" Content="{x:Static vm:Texts.JustThisTransaction}"
                       IsChecked="{Binding Categorizing.JustThis, FallbackValue=True}" />
          <RadioButton x:Name="ByRuleChoice" GroupName="CategorizeScope" Content="{x:Static vm:Texts.ByRule}"
                       IsChecked="{Binding Categorizing.ByRule, FallbackValue=False}" />
          <Grid x:Name="CategorizeCondition" ColumnDefinitions="110,*" IsVisible="{Binding Categorizing.ByRule, FallbackValue=False}">
            <TextBlock Classes="muted" Text="{x:Static vm:Texts.Condition}" VerticalAlignment="Top" Margin="{StaticResource Look.Margin.FieldLabel}" />
            <local:ConditionFields x:Name="CategorizeConditionFields" Grid.Column="1" DataContext="{Binding Categorizing.Form, FallbackValue={x:Null}}" />
          </Grid>
          <Border x:Name="CategorizeError" Classes="message error"
                  IsVisible="{Binding Categorizing.Form.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
            <TextBlock Text="{Binding Categorizing.Form.Error, FallbackValue=''}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Classes="dialogButtons">
            <Button x:Name="CategorizeDialogConfirm" Classes="primary" Content="{x:Static vm:Texts.Categorize}" Command="{Binding ConfirmCategorizeCommand}" />
            <Button x:Name="CategorizeDialogCancel" Classes="secondary" Content="{x:Static vm:Texts.CancelEdit}" Command="{Binding CancelCategorizeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- "Čo si DocuSpend zapamätá": over the "Zaradiť" box, before a transaction is categorized just for itself -->
    <Panel x:Name="PrivacyDialog" IsVisible="{Binding Categorizing.ShowsPrivacy, FallbackValue=False}">
      <Border Classes="scrim" />
      <Border x:Name="PrivacyDialogBox" Classes="card dialog" KeyboardNavigation.TabNavigation="Cycle" Focusable="True" FocusAdorner="{x:Null}">
        <StackPanel Spacing="{StaticResource Look.Space.Medium}">
          <TextBlock Classes="heading" Text="{x:Static vm:Texts.FingerprintHeading}" />
          <TextBlock x:Name="PrivacyWhat" Text="{x:Static vm:Texts.FingerprintWhat}" TextWrapping="Wrap" />
          <TextBlock x:Name="PrivacyLimits" Text="{x:Static vm:Texts.FingerprintLimits}" TextWrapping="Wrap" />
          <TextBlock x:Name="PrivacyWhere" Text="{x:Static vm:Texts.FingerprintWhere}" TextWrapping="Wrap" />
          <CheckBox x:Name="DontShowAgain" Content="{x:Static vm:Texts.DontShowAgain}" IsChecked="{Binding Categorizing.HideNoteNextTime, FallbackValue=False}" />
          <StackPanel Classes="dialogButtons">
            <Button x:Name="PrivacyDialogConfirm" Classes="primary" Content="{x:Static vm:Texts.Categorize}" Command="{Binding ConfirmPrivacyCommand}" />
            <Button x:Name="PrivacyDialogBack" Classes="secondary" Content="{x:Static vm:Texts.Back}" Command="{Binding BackFromPrivacyCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- While a file is dragged over the window. It lets the drop through to the window. -->
    <Border x:Name="DropOverlay" Classes="dropOverlay" IsVisible="{Binding IsDraggingOver}" IsHitTestVisible="False">
      <TextBlock Classes="title" Text="{x:Static vm:Texts.DropHere}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Panel>
</Window>
