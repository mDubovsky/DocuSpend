<!--
  The look (work/011-modern-look/spec.md): every text size, rounding, spacing and style the screens use. The colours
  come from DocuSpend.Presentation's Palette, as Look.<name> brushes for the current light or dark variant (see
  LookResources.cs). This is the only file allowed literal values; a test fails if a screen sets one itself.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Text sizes -->
    <x:Double x:Key="Look.FontSize.Label">12</x:Double>
    <x:Double x:Key="Look.FontSize.Body">14</x:Double>
    <x:Double x:Key="Look.FontSize.Heading">17</x:Double>
    <x:Double x:Key="Look.FontSize.KeyNumber">24</x:Double>
    <x:Double x:Key="Look.FontSize.KeyNumberMain">32</x:Double>
    <x:Double x:Key="Look.FontSize.RingTotal">20</x:Double>

    <!-- Rounding -->
    <CornerRadius x:Key="Look.Radius.Card">18</CornerRadius>
    <CornerRadius x:Key="Look.Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Look.Radius.Pill">20</CornerRadius>

    <!-- Spacing -->
    <x:Double x:Key="Look.Space.Small">6</x:Double>
    <x:Double x:Key="Look.Space.Medium">12</x:Double>
    <x:Double x:Key="Look.Space.Large">24</x:Double>
    <Thickness x:Key="Look.Margin.Window">14</Thickness>
    <Thickness x:Key="Look.Margin.Card">8</Thickness>
    <Thickness x:Key="Look.Padding.Card">22,20</Thickness>
    <Thickness x:Key="Look.Margin.Heading">0,0,0,14</Thickness>
    <Thickness x:Key="Look.Margin.KeyFigure">0,0,48,0</Thickness>
    <Thickness x:Key="Look.Margin.Count">12,0</Thickness>
    <Thickness x:Key="Look.Margin.Gap">0,0,10,0</Thickness>
    <Thickness x:Key="Look.Padding.Row">14,10</Thickness>
    <Thickness x:Key="Look.Padding.LegendRow">10,6</Thickness>
    <Thickness x:Key="Look.Padding.Segmented">3</Thickness>
    <Thickness x:Key="Look.Padding.Segment">12,5</Thickness>
    <Thickness x:Key="Look.Margin.Legend">20,0,0,0</Thickness>
    <Thickness x:Key="Look.Margin.Row">0,2</Thickness>
    <Thickness x:Key="Look.Padding.Message">12,9</Thickness>
    <Thickness x:Key="Look.Padding.Button">22,10</Thickness>
    <Thickness x:Key="Look.Padding.Start">48,56</Thickness>
    <Thickness x:Key="Look.Margin.StartButtons">0,14,0,0</Thickness>
    <Thickness x:Key="Look.Padding.Badge">10,3</Thickness>
    <Thickness x:Key="Look.Padding.Close">10,4</Thickness>
    <x:Double x:Key="Look.FontSize.Title">22</x:Double>
    <Thickness x:Key="Look.Padding.Help">8,1</Thickness>
    <Thickness x:Key="Look.Padding.SmallButton">12,3</Thickness>
    <Thickness x:Key="Look.Padding.RuleRow">8,4</Thickness>
    <x:Double x:Key="Look.Height.Chart">300</x:Double>
    <x:Double x:Key="Look.Size.Ring">260</x:Double>
    <x:Double x:Key="Look.Height.ContentMin">820</x:Double>
    <Thickness x:Key="Look.Margin.HeaderItem">0,0,12,0</Thickness>
    <Thickness x:Key="Look.Margin.HeaderCentre">12,0</Thickness>
    <Thickness x:Key="Look.Padding.Tab">16,6</Thickness>
    <x:Double x:Key="Look.Width.DialogMin">380</x:Double>
    <x:Double x:Key="Look.Width.DialogMax">520</x:Double>
    <Thickness x:Key="Look.Margin.DialogButtons">0,8,0,0</Thickness>
    <x:Double x:Key="Look.Space.HoverEdge">8</x:Double>
    <x:Double x:Key="Look.Space.HoverGap">14</x:Double>
    <x:Double x:Key="Look.Size.HoverDot">12</x:Double>
    <Thickness x:Key="Look.Padding.HoverCard">12,8</Thickness>
    <x:Double x:Key="Look.Size.ScrollBar">12</x:Double>
    <x:Double x:Key="Look.Size.ScrollThumb">6</x:Double>
    <x:Double x:Key="Look.Size.ScrollThumbMin">32</x:Double>
    <CornerRadius x:Key="Look.Radius.ScrollThumb">3</CornerRadius>

    <!--
      Scroll bars (#19): a slim, rounded handle on a faint track, in a strip of their own, with no arrow buttons.
      This replaces Fluent's scroll bar as a whole, so nothing of its expanding, arrowed bar is left. Clicking the track
      either side of the handle still pages, through the transparent page buttons.
    -->
    <ControlTheme x:Key="Look.ScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource Look.ScrollThumb}" />
      <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.ScrollThumb}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Look.Muted}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource Look.Muted}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="Look.ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
      <Style Selector="^:vertical">
        <Setter Property="Width" Value="{StaticResource Look.Size.ScrollBar}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Border Width="{StaticResource Look.Size.ScrollThumb}" HorizontalAlignment="Center"
                      Background="{DynamicResource Look.Hover}" CornerRadius="{StaticResource Look.Radius.ScrollThumb}" />
              <Track Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                     DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                     Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource Look.ScrollPage}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource Look.ScrollPage}" />
                </Track.IncreaseButton>
                <Thumb Theme="{StaticResource Look.ScrollThumb}" Width="{StaticResource Look.Size.ScrollThumb}"
                       MinHeight="{StaticResource Look.Size.ScrollThumbMin}" HorizontalAlignment="Center" />
              </Track>
            </Panel>
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="^:horizontal">
        <Setter Property="Height" Value="{StaticResource Look.Size.ScrollBar}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Border Height="{StaticResource Look.Size.ScrollThumb}" VerticalAlignment="Center"
                      Background="{DynamicResource Look.Hover}" CornerRadius="{StaticResource Look.Radius.ScrollThumb}" />
              <Track Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                     DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                     Orientation="Horizontal">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource Look.ScrollPage}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource Look.ScrollPage}" />
                </Track.IncreaseButton>
                <Thumb Theme="{StaticResource Look.ScrollThumb}" Height="{StaticResource Look.Size.ScrollThumb}"
                       MinWidth="{StaticResource Look.Size.ScrollThumbMin}" VerticalAlignment="Center" />
              </Track>
            </Panel>
          </ControlTemplate>
        </Setter>
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- Every scroll bar always shows while its list has more than fits, beside the list rather than over it (#19).
       A list box binds its inner scroll viewer's setting to its own, which outranks a style, so it gets it too. -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>

  <!-- The window: background, and the body text everything inherits -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Look.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Body}" />
  </Style>

  <!-- Cards: rounded, slightly lighter than the window, with a soft shadow -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Look.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Look.CardEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Card}" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Card}" />
    <Setter Property="BoxShadow" Value="0 6 24 0 #1A000000" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Heading}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Muted}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Look.Muted}" />
  </Style>
  <Style Selector="TextBlock.keyNumber">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.KeyNumber}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.keyNumber.main">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.KeyNumberMain}" />
  </Style>
  <Style Selector="TextBlock.ringTotal">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.RingTotal}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.empty">
    <Setter Property="Foreground" Value="{DynamicResource Look.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Money coming in; money going out keeps the normal text colour -->
  <Style Selector="TextBlock.incoming">
    <Setter Property="Foreground" Value="{DynamicResource Look.Positive}" />
  </Style>

  <!-- Lists: rows with room, a soft hover, and the selected row as an accent pill -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Row}" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Row}" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
  </Style>
  <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock.name">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A segmented choice (light or dark): a pill holding pills, the chosen one in the accent tint. It keeps its own
       height in a taller row, so its pills keep their shape and their text stays centred (#19). -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource Look.Hover}" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Segmented}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Segment}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Label}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- A choice under the pointer: its own tone, since the switch's background is the rows' hover tone (#19). The
       chosen choice keeps its accent pill, by the rule for a selected row above. -->
  <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.SwitchHover}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The spending chart's legend: one row per category, clickable like its slice -->
  <Style Selector="Button.legend">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.LegendRow}" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="Button.legend:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="Button.legend:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Gap}" />
  </Style>

  <!-- Form controls: rounded -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Control}" />
    <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Control}" />
  </Style>

  <!-- The one primary button -->
  <Style Selector="Button.primary">
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Button}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Look.OnPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Look.Primary}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.OnPrimary}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.OnPrimary}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- Messages: an error and a confirmation, each on its own tint -->
  <Style Selector="Border.message">
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Control}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Message}" />
  </Style>
  <Style Selector="Border.message.error">
    <Setter Property="Background" Value="{DynamicResource Look.ErrorTint}" />
  </Style>
  <Style Selector="Border.message.error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Look.Error}" />
  </Style>
  <Style Selector="Border.message.confirmation">
    <Setter Property="Background" Value="{DynamicResource Look.PositiveTint}" />
  </Style>
  <Style Selector="Border.message.confirmation TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Look.Positive}" />
  </Style>
  <!-- Every other button: the same pill, outlined in the accent colour, so the primary one stays the only filled one -->
  <Style Selector="Button.secondary">
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Button}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Look.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Accent}" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Look.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Accent}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Look.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Accent}" />
  </Style>

  <!-- A message's close button: quiet, in the message's own colour -->
  <Style Selector="Button.close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Close}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Hover}" />
  </Style>

  <!-- The start screen: one card, centred, with a large title -->
  <Style Selector="Border.card.start">
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Start}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The example's label in the header, so nobody takes it for their own account -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Badge}" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- While a file is dragged over the window -->
  <Style Selector="Border.dropOverlay">
    <Setter Property="Background" Value="{DynamicResource Look.Background}" />
    <Setter Property="Opacity" Value="0.94" />
    <Setter Property="BorderBrush" Value="{DynamicResource Look.Accent}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Card}" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Window}" />
  </Style>
  <Style Selector="Border.dropOverlay TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Look.Accent}" />
  </Style>

  <!-- The rule editor (work/024-edit-rules/spec.md) -->
  <!-- A field with a help mark beside it -->
  <Style Selector="StackPanel.headingRow">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{StaticResource Look.Space.Small}" />
  </Style>
  <!-- The help mark: a small outlined "?" whose tooltip explains; it can be reached with the keyboard -->
  <Style Selector="Button.help">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Help}" />
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Look.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Accent}" />
  </Style>
  <Style Selector="Button.help:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Look.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Accent}" />
  </Style>
  <!-- A rule in "Moje pravidlá"; the one open in the form is marked like a selected row -->
  <Style Selector="Border.ruleRow">
    <Setter Property="Padding" Value="{StaticResource Look.Padding.RuleRow}" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Row}" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
  </Style>
  <Style Selector="Border.ruleRow.editing">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
  </Style>
  <!-- A row's own buttons: secondary, smaller -->
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="{StaticResource Look.Padding.SmallButton}" />
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Label}" />
  </Style>

  <!-- The charts' hover cards and the dot on the balance line: drawn over the whole window, so a card is never cut by a chart -->
  <Style Selector="Border.hoverCard">
    <Setter Property="Background" Value="{DynamicResource Look.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Look.CardEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Control}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.HoverCard}" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #26000000" />
  </Style>
  <Style Selector="Border.hoverCard TextBlock.name">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Ellipse.hoverDot">
    <Setter Property="Width" Value="{StaticResource Look.Size.HoverDot}" />
    <Setter Property="Height" Value="{StaticResource Look.Size.HoverDot}" />
    <Setter Property="Fill" Value="{DynamicResource Look.Accent}" />
    <Setter Property="Stroke" Value="{DynamicResource Look.Card}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>

  <!-- A pop-up question: the window dimmed behind a card in its middle -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource Look.Background}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Border.card.dialog">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="{StaticResource Look.Width.DialogMin}" />
    <Setter Property="MaxWidth" Value="{StaticResource Look.Width.DialogMax}" />
  </Style>
  <Style Selector="StackPanel.dialogButtons">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="{StaticResource Look.Space.Medium}" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.DialogButtons}" />
  </Style>

  <!-- A list of rules fills its card and scrolls inside it -->
  <Style Selector="ScrollViewer.ruleList">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- The rules card's heading: the segmented choice, at the size of a heading -->
  <Style Selector="ListBox.segmented.tabs">
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Heading}" />
  </Style>
  <Style Selector="ListBox.segmented.tabs ListBoxItem">
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Tab}" />
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</Styles>
