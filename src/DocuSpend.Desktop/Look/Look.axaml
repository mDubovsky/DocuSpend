<!--
  The look (work/011-modern-look/spec.md): every text size, rounding, spacing and style the screens use. The colours
  come from DocuSpend.Presentation's Palette, as Look.<name> brushes for the current light or dark variant (see
  LookResources.cs). This is the only file allowed literal values; a test fails if a screen sets one itself.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Text sizes -->
    <x:Double x:Key="Look.FontSize.Label">12</x:Double>
    <x:Double x:Key="Look.FontSize.Body">14</x:Double>
    <x:Double x:Key="Look.FontSize.Heading">17</x:Double>
    <x:Double x:Key="Look.FontSize.KeyNumber">24</x:Double>
    <x:Double x:Key="Look.FontSize.KeyNumberMain">32</x:Double>
    <x:Double x:Key="Look.FontSize.RingTotal">20</x:Double>

    <!-- Rounding -->
    <CornerRadius x:Key="Look.Radius.Card">18</CornerRadius>
    <CornerRadius x:Key="Look.Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Look.Radius.Pill">20</CornerRadius>

    <!-- Spacing -->
    <x:Double x:Key="Look.Space.Small">6</x:Double>
    <x:Double x:Key="Look.Space.Medium">12</x:Double>
    <x:Double x:Key="Look.Space.Large">24</x:Double>
    <Thickness x:Key="Look.Margin.Window">14</Thickness>
    <Thickness x:Key="Look.Margin.Card">8</Thickness>
    <Thickness x:Key="Look.Padding.Card">22,20</Thickness>
    <Thickness x:Key="Look.Margin.Heading">0,0,0,14</Thickness>
    <Thickness x:Key="Look.Margin.KeyFigure">0,0,48,0</Thickness>
    <Thickness x:Key="Look.Margin.Count">12,0</Thickness>
    <Thickness x:Key="Look.Margin.Gap">0,0,10,0</Thickness>
    <Thickness x:Key="Look.Padding.Row">14,10</Thickness>
    <Thickness x:Key="Look.Padding.LegendRow">10,6</Thickness>
    <Thickness x:Key="Look.Margin.Legend">20,0,0,0</Thickness>
    <Thickness x:Key="Look.Margin.Row">0,2</Thickness>
    <Thickness x:Key="Look.Padding.Message">12,9</Thickness>
    <Thickness x:Key="Look.Padding.Button">22,10</Thickness>
  </Styles.Resources>

  <!-- The window: background, and the body text everything inherits -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Look.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Body}" />
  </Style>

  <!-- Cards: rounded, slightly lighter than the window, with a soft shadow -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Look.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Look.CardEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Card}" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Card}" />
    <Setter Property="BoxShadow" Value="0 6 24 0 #1A000000" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Heading}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Muted}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Look.Muted}" />
  </Style>
  <Style Selector="TextBlock.keyNumber">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.KeyNumber}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.keyNumber.main">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.KeyNumberMain}" />
  </Style>
  <Style Selector="TextBlock.ringTotal">
    <Setter Property="FontSize" Value="{StaticResource Look.FontSize.RingTotal}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.empty">
    <Setter Property="Foreground" Value="{DynamicResource Look.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Money coming in; money going out keeps the normal text colour -->
  <Style Selector="TextBlock.incoming">
    <Setter Property="Foreground" Value="{DynamicResource Look.Positive}" />
  </Style>

  <!-- Lists: rows with room, a soft hover, and the selected row as an accent pill -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Row}" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Row}" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
  </Style>
  <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock.name">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The spending chart's legend: one row per category, clickable like its slice -->
  <Style Selector="Button.legend">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.LegendRow}" />
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="Button.legend:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="Button.legend:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.AccentTint}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.Text}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="{StaticResource Look.Margin.Gap}" />
  </Style>

  <!-- Form controls: rounded -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Control}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Control}" />
  </Style>

  <!-- The one primary button -->
  <Style Selector="Button.primary">
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Button}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Look.OnPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Look.Primary}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.OnPrimary}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Look.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Look.OnPrimary}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- Messages: an error and a confirmation, each on its own tint -->
  <Style Selector="Border.message">
    <Setter Property="CornerRadius" Value="{StaticResource Look.Radius.Control}" />
    <Setter Property="Padding" Value="{StaticResource Look.Padding.Message}" />
  </Style>
  <Style Selector="Border.message.error">
    <Setter Property="Background" Value="{DynamicResource Look.ErrorTint}" />
  </Style>
  <Style Selector="Border.message.error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Look.Error}" />
  </Style>
  <Style Selector="Border.message.confirmation">
    <Setter Property="Background" Value="{DynamicResource Look.PositiveTint}" />
  </Style>
  <Style Selector="Border.message.confirmation TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Look.Positive}" />
  </Style>

</Styles>
