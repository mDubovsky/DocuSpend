<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An experiment (plan: tests): the real window, loaded from its compiled XAML and driven without a screen through
    Avalonia's headless platform. Avalonia 11.3's xunit integration targets xunit v2 only, so the session is driven by hand.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DocuSpend.Desktop\DocuSpend.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>

</Project>
