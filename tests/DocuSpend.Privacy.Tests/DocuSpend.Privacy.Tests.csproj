<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Reference the networking ban's analyzer as a library, to run it on snippets (see Directory.Build.targets). -->
    <PrivacyAnalyzerAsLibrary>true</PrivacyAnalyzerAsLibrary>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <!-- The analyzer is compiled against version 8; xunit alone would bring an older one. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <!-- The dependency check inspects every shipping project's build output: build them first, without referencing them. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\*\*.csproj;..\..\tools\*\*.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Configuration" Value="$(Configuration)" />
  </ItemGroup>

</Project>
