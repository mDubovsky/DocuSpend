<Project>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- The privacy rules (decision 0006); the ban itself is wired up in Directory.Build.targets. -->
  <PropertyGroup>
    <PrivacyDir>$(MSBuildThisFileDirectory)privacy\</PrivacyDir>
    <PrivacyBannedSymbols>$(PrivacyDir)BannedSymbols.txt</PrivacyBannedSymbols>
    <PrivacyBanAnalyzerVersion>5.6.0</PrivacyBanAnalyzerVersion>
    <!-- Libraries copy their packages to their output too, so the dependency check sees everything a project ships. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- The user interface toolkit (decision 0005). One version for every Avalonia package. -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <!-- The build telemetry package Avalonia brings; switched off in Directory.Build.targets. -->
    <AvaloniaBuildServicesVersion>11.3.2</AvaloniaBuildServicesVersion>
  </PropertyGroup>

  <!--
    dependency-vulnerabilities: a package with a known vulnerability of moderate severity or higher, direct or
    indirect, fails the build. NU1900 (the vulnerability data couldn't be fetched) stays a warning so an offline
    build still works; the dependency-vulnerabilities job in CI makes it an error.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
